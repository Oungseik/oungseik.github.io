---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const pageTitle = "Download CV | Min Aung Thu Win";
const pageDescription =
	"Download a PDF copy of Min Aung Thu Win's CV, or review the full web version on this page.";

const cv = {
	name: "Min Aung Thu Win",
	headline: "Senior Backend Engineer / Software Engineer",
	location: "Myanmar",
	availability: "Remote-ready",
	githubLabel: "Oungseik",
	githubUrl: "https://github.com/oungseik",
	email: "mhemaungthuwin@gmail.com",
	emailUrl: "mailto:mhemaungthuwin@gmail.com",
	phone: "+95 9 783 668091",
	summary:
		"Backend-focused Software Engineer with 4+ years of experience designing and building scalable systems, automation platforms, and developer tooling. Strong expertise in TypeScript ecosystems, distributed systems, and backend architecture, with hands-on experience in device farms, real-time systems, and AI-powered data services. Proven ability to deliver high-impact solutions that reduce manual operations and improve system efficiency.",
	experience: [
		{
			company: "Crossworks",
			role: "Full-stack Developer",
			period: "Apr 2025 - Present",
			bullets: [
				"Develop and maintain full-stack applications with focus on backend architecture and system integrations.",
				"Build scalable APIs and services using modern TypeScript and backend frameworks.",
				"Collaborate with cross-functional teams to deliver production-grade features.",
			],
		},
		{
			company: "Brillar",
			role: "Backend Developer -> Senior Backend Developer",
			period: "Sep 2023 - Apr 2025",
			bullets: [
				"Led backend development for Test Canvas, an internal testing infrastructure platform.",
				"Designed real-time device management, monitoring, authentication, and access control systems.",
				"Migrated a large JavaScript codebase to TypeScript to improve maintainability and type safety.",
				"Enabled distributed device execution across multiple servers.",
			],
			impact: [
				"Eliminated manual test environment setup for QA teams.",
				"Enabled parallel execution across 10+ devices.",
				"Delivered platform-agnostic testing support for Android and iOS.",
			],
		},
		{
			company: "Kiosk",
			role: "Full-stack Developer",
			period: "Apr 2023 - Sep 2023",
			bullets: [
				"Built and maintained full-stack features for production systems.",
				"Contributed across frontend and backend logic using modern JavaScript frameworks.",
			],
		},
		{
			company: "Qualy Myanmar Inc",
			role: "Frontend Developer",
			period: "Apr 2022 - Apr 2023",
			bullets: [
				"Developed responsive frontend applications.",
				"Worked closely with backend teams to integrate APIs and improve user experience.",
			],
		},
	],
	projects: [
		{
			name: "Bookogsend",
			tagline: "Shipping management platform",
			link: "https://bookogsend.dk/",
			points: [
				"Built a multi-service shipping platform integrating providers like GLS and TeamJK.",
				"Developed a WooCommerce plugin to automate shipment synchronization.",
				"Implemented shipping methods, payment systems, reconciliation workflows, and inventory features.",
			],
			tech: [
				"Next.js",
				"tRPC",
				"Prisma",
				"PostgreSQL",
				"Firebase Auth",
				"Google Cloud Storage",
				"QStash",
				"Vercel",
			],
			impact: [
				"Automated shipping workflows for e-commerce merchants.",
				"Reduced manual shipment handling.",
				"Enabled seamless WooCommerce integration for operational growth.",
			],
		},
		{
			name: "Test Canvas",
			tagline: "Device farm and testing platform",
			points: [
				"Built an internal device farm system for Android and iOS testing.",
				"Automated Appium and Selenium environment setup per device.",
				"Implemented real-time monitoring, screen mirroring, and distributed orchestration across multiple servers.",
			],
			tech: ["Express.js", "MongoDB", "Socket.IO", "Appium", "ADB", "go-ios", "Next.js"],
			impact: [
				"Eliminated manual setup for testers.",
				"Enabled concurrent testing on 10+ devices.",
				"Reduced QA bottlenecks and improved throughput.",
			],
		},
		{
			name: "SQL Agent",
			tagline: "Natural language data interface",
			points: [
				"Built a microservice allowing users to query databases using natural language.",
				"Generated charts and insights automatically from user queries.",
			],
			tech: ["Python", "FastAPI", "LangChain"],
		},
	],
	skills: [
		{
			label: "Languages",
			items: ["TypeScript", "JavaScript", "Rust", "Python", "Go", "PHP"],
		},
		{
			label: "Backend",
			items: ["Express.js", "Hono", "tRPC", "FastAPI", "Axum", "chi"],
		},
		{
			label: "Frontend",
			items: ["Next.js", "SvelteKit", "shadcn"],
		},
		{
			label: "DevOps and Infrastructure",
			items: ["Docker", "Nginx", "Nix", "NixOS"],
		},
		{
			label: "Databases",
			items: ["PostgreSQL", "MongoDB", "SQLite", "Prisma", "Drizzle", "Ent"],
		},
	],
	education: ["Bachelor's Degree in Mathematics"],
	strengths: [
		"Strong system design and backend architecture skills.",
		"Experience with real-time systems and distributed infrastructure.",
		"Focus on developer productivity and automation.",
		"Comfortable working in remote and async environments.",
	],
};

const downloadPayload = JSON.stringify(cv).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body class="bg-base-100 text-base-content">
		<div class="site-chrome">
			<Header />
		</div>

		<main class="cv-page relative overflow-hidden pb-20">
			<div
				class="cv-glow pointer-events-none absolute inset-x-0 top-0 h-[32rem] opacity-80"
				aria-hidden="true"
			>
			</div>

			<div class="mx-auto max-w-6xl px-4 pt-28">
				<section
					class="cv-actions mb-6 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
				>
					<div class="max-w-2xl">
						<p class="cv-kicker">Curriculum Vitae</p>
						<h1
							class="mt-3 text-4xl font-bold tracking-tight text-balance text-[#171410] md:text-5xl"
						>
							Download my CV in one click.
						</h1>
						<p class="mt-4 text-base leading-7 text-[#5d544d] md:text-lg">
							If you are visiting my website and need a copy of my CV, this page is here to make
							that easy. You can download a PDF immediately, or review the full version below before
							saving it.
						</p>
					</div>

					<div class="flex flex-col gap-3 sm:flex-row">
						<button
							id="download-cv"
							class="btn rounded-full border-0 bg-[#171410] px-7 text-[#f7f1e8]"
						>
							Download CV PDF
						</button>
					</div>
				</section>

				<p class="cv-note mb-8 max-w-2xl text-sm leading-6 text-[#6a615a]">
					The button above generates a PDF in your browser and downloads it directly. The full CV
					stays readable on this page for a quick preview.
				</p>

				<article
					id="cv-document"
					class="cv-paper overflow-hidden rounded-[2rem] border border-[#171410]/8 bg-[#f7f1e8] text-[#171410] shadow-[0_32px_80px_rgba(23,20,16,0.12)]"
				>
					<div class="grid gap-0 lg:grid-cols-[0.82fr_1.18fr]">
						<section
							class="border-b border-[#171410]/10 bg-[#171410] px-6 py-8 text-[#f7f1e8] md:px-8 md:py-10 lg:col-span-2"
						>
							<div class="grid gap-8 xl:grid-cols-[1.25fr_0.75fr] xl:items-end">
								<div>
									<p class="font-mono text-xs tracking-[0.32em] text-[#d9c7b5] uppercase">
										Backend Systems / Automation / Developer Tooling
									</p>
									<h2 class="mt-4 text-4xl font-bold tracking-tight text-balance md:text-6xl">
										{cv.name}
									</h2>
									<p class="mt-4 max-w-2xl text-lg leading-8 text-[#eadbcc] md:text-xl">
										{cv.headline}
									</p>
								</div>

								<div class="grid gap-3 sm:grid-cols-3 xl:grid-cols-1">
									<div class="rounded-[1.4rem] border border-white/10 bg-white/6 p-4">
										<p class="font-mono text-[0.7rem] tracking-[0.24em] text-[#d2c0ae] uppercase">
											Base
										</p>
										<p class="mt-3 text-lg font-semibold">{cv.location}</p>
									</div>
									<div class="rounded-[1.4rem] border border-white/10 bg-white/6 p-4">
										<p class="font-mono text-[0.7rem] tracking-[0.24em] text-[#d2c0ae] uppercase">
											Mode
										</p>
										<p class="mt-3 text-lg font-semibold">{cv.availability}</p>
									</div>
									<div class="rounded-[1.4rem] border border-white/10 bg-white/6 p-4">
										<p class="font-mono text-[0.7rem] tracking-[0.24em] text-[#d2c0ae] uppercase">
											Focus
										</p>
										<p class="mt-3 text-lg font-semibold">Backend systems at scale</p>
									</div>
								</div>
							</div>
						</section>

						<aside
							class="border-r-0 border-[#171410]/10 bg-[#efe6db] px-6 py-8 md:px-8 md:py-10 lg:border-r"
						>
							<section>
								<p class="cv-kicker">Contact</p>
								<div class="mt-5 space-y-4">
									<a class="cv-contact-card" href={cv.emailUrl}>
										<span class="cv-contact-label">Email</span>
										<span class="cv-contact-value">{cv.email}</span>
									</a>
									<a class="cv-contact-card" href={cv.githubUrl} target="_blank" rel="noreferrer">
										<span class="cv-contact-label">GitHub</span>
										<span class="cv-contact-value">{cv.githubLabel}</span>
									</a>
								</div>
							</section>

							<section class="mt-10">
								<p class="cv-kicker">Strengths</p>
								<ul class="mt-5 space-y-3">
									{cv.strengths.map((strength) => <li class="cv-list-item">{strength}</li>)}
								</ul>
							</section>

							<section class="mt-10">
								<p class="cv-kicker">Skills</p>
								<div class="mt-5 space-y-6">
									{
										cv.skills.map((group) => (
											<div>
												<h3 class="text-sm font-semibold tracking-[0.16em] text-[#5c534c] uppercase">
													{group.label}
												</h3>
												<div class="mt-3 flex flex-wrap gap-2">
													{group.items.map((item) => (
														<span class="cv-chip">{item}</span>
													))}
												</div>
											</div>
										))
									}
								</div>
							</section>

							<section class="mt-10">
								<p class="cv-kicker">Education</p>
								<div class="mt-5 space-y-3">
									{
										cv.education.map((item) => (
											<div class="rounded-[1.2rem] border border-[#171410]/8 bg-white/60 px-4 py-4">
												<p class="text-base font-medium text-[#171410]">{item}</p>
											</div>
										))
									}
								</div>
							</section>
						</aside>

						<div class="px-6 py-8 md:px-10 md:py-10">
							<section class="border-b border-[#171410]/10 pb-8">
								<p class="cv-kicker">Summary</p>
								<p class="mt-5 text-lg leading-8 text-[#2f2924]">
									{cv.summary}
								</p>
							</section>

							<section class="pt-8">
								<div class="flex items-center justify-between gap-4">
									<p class="cv-kicker">Experience</p>
									<p class="font-mono text-xs tracking-[0.22em] text-[#8a7c70] uppercase">
										2022 - Present
									</p>
								</div>

								<div class="cv-timeline mt-6 space-y-8">
									{
										cv.experience.map((item) => (
											<article class="cv-entry">
												<div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
													<div>
														<h3 class="text-2xl font-semibold tracking-tight text-[#171410]">
															{item.role}
														</h3>
														<p class="mt-1 text-base font-medium text-[#6a5f57]">{item.company}</p>
													</div>
													<p class="font-mono text-xs tracking-[0.22em] text-[#8a7c70] uppercase">
														{item.period}
													</p>
												</div>

												<ul class="mt-4 space-y-3">
													{item.bullets.map((bullet) => (
														<li class="cv-list-item">{bullet}</li>
													))}
												</ul>

												{item.impact && (
													<div class="mt-5 rounded-[1.4rem] border border-[#c66d45]/18 bg-[#fff7f1] p-5">
														<p class="font-mono text-xs tracking-[0.22em] text-[#b25732] uppercase">
															Key impact
														</p>
														<ul class="mt-3 space-y-3">
															{item.impact.map((impact) => (
																<li class="cv-list-item">{impact}</li>
															))}
														</ul>
													</div>
												)}
											</article>
										))
									}
								</div>
							</section>

							<section class="border-t border-[#171410]/10 pt-8">
								<p class="cv-kicker">Projects</p>
								<div class="mt-6 grid gap-5">
									{
										cv.projects.map((project) => (
											<article class="rounded-[1.6rem] border border-[#171410]/10 bg-white/55 p-6">
												<div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
													<div>
														<h3 class="text-2xl font-semibold tracking-tight text-[#171410]">
															{project.name}
														</h3>
														<p class="mt-2 text-base text-[#6b6057]">{project.tagline}</p>
													</div>
													{project.link && (
														<a
															href={project.link}
															target="_blank"
															rel="noreferrer"
															class="inline-flex items-center rounded-full border border-[#171410]/10 px-4 py-2 text-sm font-medium text-[#171410] transition hover:border-[#171410]/25 hover:bg-white"
														>
															Visit project
														</a>
													)}
												</div>

												<ul class="mt-5 space-y-3">
													{project.points.map((point) => (
														<li class="cv-list-item">{point}</li>
													))}
												</ul>

												<div class="mt-5">
													<p class="font-mono text-xs tracking-[0.22em] text-[#8a7c70] uppercase">
														Tech
													</p>
													<div class="mt-3 flex flex-wrap gap-2">
														{project.tech.map((item) => (
															<span class="cv-chip">{item}</span>
														))}
													</div>
												</div>

												{project.impact && (
													<div class="mt-5 rounded-[1.4rem] border border-[#171410]/8 bg-[#f3ece2] p-5">
														<p class="font-mono text-xs tracking-[0.22em] text-[#8a7c70] uppercase">
															Impact
														</p>
														<ul class="mt-3 space-y-3">
															{project.impact.map((impact) => (
																<li class="cv-list-item">{impact}</li>
															))}
														</ul>
													</div>
												)}
											</article>
										))
									}
								</div>
							</section>
						</div>
					</div>
				</article>
			</div>
		</main>

		<div class="site-chrome">
			<Footer />
		</div>

		<script id="cv-download-data" type="application/json" set:html={downloadPayload} />

		<script>
			type DownloadProject = {
				name: string;
				tagline: string;
				link?: string;
				points: string[];
				tech: string[];
				impact?: string[];
			};

			type DownloadExperience = {
				company: string;
				role: string;
				period: string;
				bullets: string[];
				impact?: string[];
			};

			type DownloadSkillGroup = {
				label: string;
				items: string[];
			};

			type DownloadCv = {
				name: string;
				headline: string;
				location: string;
				availability: string;
				githubLabel: string;
				githubUrl: string;
				email: string;
				emailUrl: string;
				phone: string;
				summary: string;
				experience: DownloadExperience[];
				projects: DownloadProject[];
				skills: DownloadSkillGroup[];
				education: string[];
				strengths: string[];
			};

			type PdfFont = "F1" | "F2";
			type PdfColor = "body" | "muted" | "accent";

			type PdfLine = {
				text: string;
				size: number;
				font: PdfFont;
				color?: PdfColor;
				gapBefore?: number;
				indent?: number;
				pageBreakBefore?: boolean;
			};

			const downloadButton = document.getElementById("download-cv");
			const payloadElement = document.getElementById("cv-download-data");
			const payload = payloadElement?.textContent
				? (JSON.parse(payloadElement.textContent) as DownloadCv)
				: null;

			const PDF_PAGE_WIDTH = 595;
			const PDF_PAGE_HEIGHT = 842;
			const PDF_MARGIN_X = 48;
			const PDF_TOP = 792;
			const PDF_BOTTOM = 54;
			const PDF_CONTENT_WIDTH = PDF_PAGE_WIDTH - PDF_MARGIN_X * 2;

			function sanitizePdfText(value: string) {
				return value
					.normalize("NFKD")
					.replace(/[^\x20-\x7E]/g, " ")
					.replace(/\s+/g, " ")
					.trim();
			}

			function escapePdfText(value: string) {
				return sanitizePdfText(value)
					.replaceAll("\\", "\\\\")
					.replaceAll("(", "\\(")
					.replaceAll(")", "\\)");
			}

			function wrapPdfText(text: string, size: number, indent = 0) {
				const normalized = sanitizePdfText(text);
				if (!normalized) return [];

				const maxChars = Math.max(26, Math.floor((PDF_CONTENT_WIDTH - indent) / (size * 0.52)));
				const words = normalized.split(" ");
				const lines: string[] = [];
				let current = "";

				for (const word of words) {
					const next = current ? `${current} ${word}` : word;

					if (next.length <= maxChars) {
						current = next;
						continue;
					}

					if (current) {
						lines.push(current);
						current = word;
						continue;
					}

					let remaining = word;

					while (remaining.length > maxChars) {
						lines.push(remaining.slice(0, maxChars));
						remaining = remaining.slice(maxChars);
					}

					current = remaining;
				}

				if (current) lines.push(current);

				return lines;
			}

			function addWrappedPdfText(lines: PdfLine[], text: string, options: Omit<PdfLine, "text">) {
				const wrapped = wrapPdfText(text, options.size, options.indent ?? 0);

				wrapped.forEach((line, index) => {
					lines.push({
						...options,
						text: line,
						gapBefore: index === 0 ? options.gapBefore : 0,
					});
				});
			}

			function addPdfBullets(lines: PdfLine[], items: string[], gapBefore = 8) {
				items.forEach((item, index) => {
					addWrappedPdfText(lines, `- ${item}`, {
						size: 10.5,
						font: "F1",
						color: "body",
						indent: 12,
						gapBefore: index === 0 ? gapBefore : 4,
					});
				});
			}

			function buildPdfLines(data: DownloadCv) {
				const lines: PdfLine[] = [];

				lines.push({ text: data.name, size: 24, font: "F2", color: "body" });
				addWrappedPdfText(lines, data.headline, {
					size: 13,
					font: "F1",
					color: "muted",
					gapBefore: 6,
				});
				addWrappedPdfText(lines, `${data.location} | ${data.availability}`, {
					size: 10.5,
					font: "F1",
					color: "muted",
					gapBefore: 10,
				});
				addWrappedPdfText(lines, `${data.email} | ${data.phone} | ${data.githubUrl}`, {
					size: 10.5,
					font: "F1",
					color: "muted",
					gapBefore: 4,
				});

				lines.push({
					text: "SUMMARY",
					size: 11.5,
					font: "F2",
					color: "accent",
					gapBefore: 24,
				});
				addWrappedPdfText(lines, data.summary, {
					size: 11,
					font: "F1",
					color: "body",
					gapBefore: 8,
				});

				lines.push({
					text: "EXPERIENCE",
					size: 11.5,
					font: "F2",
					color: "accent",
					gapBefore: 22,
				});
				data.experience.forEach((item) => {
					addWrappedPdfText(lines, `${item.role} - ${item.company}`, {
						size: 11.5,
						font: "F2",
						color: "body",
						gapBefore: 12,
					});
					addWrappedPdfText(lines, item.period, {
						size: 10,
						font: "F1",
						color: "muted",
						gapBefore: 3,
					});
					addPdfBullets(lines, item.bullets);

					if (item.impact?.length) {
						lines.push({
							text: "Impact",
							size: 10,
							font: "F2",
							color: "muted",
							gapBefore: 8,
							indent: 12,
						});
						addPdfBullets(lines, item.impact, 6);
					}
				});

				lines.push({
					text: "PROJECTS",
					size: 11.5,
					font: "F2",
					color: "accent",
					gapBefore: 22,
				});
				data.projects.forEach((project) => {
					addWrappedPdfText(lines, `${project.name} - ${project.tagline}`, {
						size: 11.5,
						font: "F2",
						color: "body",
						gapBefore: 12,
					});

					if (project.link) {
						addWrappedPdfText(lines, project.link, {
							size: 10,
							font: "F1",
							color: "muted",
							gapBefore: 3,
						});
					}

					addPdfBullets(lines, project.points);
					addWrappedPdfText(lines, `Tech: ${project.tech.join(", ")}`, {
						size: 10.5,
						font: "F1",
						color: "muted",
						gapBefore: 8,
						indent: 12,
					});

					if (project.impact?.length) {
						lines.push({
							text: "Impact",
							size: 10,
							font: "F2",
							color: "muted",
							gapBefore: 8,
							indent: 12,
						});
						addPdfBullets(lines, project.impact, 6);
					}
				});

				lines.push({
					text: "SKILLS",
					size: 11.5,
					font: "F2",
					color: "accent",
					gapBefore: 22,
					pageBreakBefore: true,
				});
				data.skills.forEach((group) => {
					addWrappedPdfText(lines, `${group.label}: ${group.items.join(", ")}`, {
						size: 10.5,
						font: "F1",
						color: "body",
						gapBefore: 8,
					});
				});

				lines.push({
					text: "EDUCATION",
					size: 11.5,
					font: "F2",
					color: "accent",
					gapBefore: 22,
				});
				addPdfBullets(lines, data.education, 8);

				lines.push({
					text: "ADDITIONAL STRENGTHS",
					size: 11.5,
					font: "F2",
					color: "accent",
					gapBefore: 22,
				});
				addPdfBullets(lines, data.strengths, 8);

				return lines;
			}

			function renderPdfPages(lines: PdfLine[]) {
				const colorMap: Record<PdfColor, string> = {
					body: "0.09 0.08 0.06",
					muted: "0.40 0.36 0.33",
					accent: "0.72 0.37 0.22",
				};
				const pages: string[] = [];
				let currentPage: string[] = [];
				let y = PDF_TOP;

				for (const line of lines) {
					if (line.pageBreakBefore && currentPage.length) {
						pages.push(currentPage.join("\n"));
						currentPage = [];
						y = PDF_TOP;
					}

					const gapBefore = line.gapBefore ?? 0;
					const lineHeight = line.size * 1.45;

					y -= gapBefore;

					if (y - lineHeight < PDF_BOTTOM) {
						pages.push(currentPage.join("\n"));
						currentPage = [];
						y = PDF_TOP;
					}

					const x = PDF_MARGIN_X + (line.indent ?? 0);
					const color = colorMap[line.color ?? "body"];
					currentPage.push(
						`BT /${line.font} ${line.size} Tf ${color} rg 1 0 0 1 ${x.toFixed(2)} ${y.toFixed(2)} Tm (${escapePdfText(line.text)}) Tj ET`,
					);

					y -= lineHeight;
				}

				if (currentPage.length) {
					pages.push(currentPage.join("\n"));
				}

				return pages;
			}

			function buildPdfDocument(data: DownloadCv) {
				const pages = renderPdfPages(buildPdfLines(data));
				const objects: string[] = [];
				const addObject = (body: string) => {
					objects.push(body);
					return objects.length;
				};

				const pagesId = addObject("");
				const regularFontId = addObject("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>");
				const boldFontId = addObject("<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>");
				const pageIds: number[] = [];

				for (const content of pages) {
					const contentId = addObject(
						`<< /Length ${content.length} >>\nstream\n${content}\nendstream`,
					);
					const pageId = addObject(
						`<< /Type /Page /Parent ${pagesId} 0 R /MediaBox [0 0 ${PDF_PAGE_WIDTH} ${PDF_PAGE_HEIGHT}] /Resources << /Font << /F1 ${regularFontId} 0 R /F2 ${boldFontId} 0 R >> >> /Contents ${contentId} 0 R >>`,
					);

					pageIds.push(pageId);
				}

				objects[pagesId - 1] =
					`<< /Type /Pages /Kids [${pageIds.map((id) => `${id} 0 R`).join(" ")}] /Count ${pageIds.length} >>`;
				const catalogId = addObject(`<< /Type /Catalog /Pages ${pagesId} 0 R >>`);

				let pdf = "%PDF-1.4\n";
				const offsets = [0];

				objects.forEach((objectBody, index) => {
					offsets.push(pdf.length);
					pdf += `${index + 1} 0 obj\n${objectBody}\nendobj\n`;
				});

				const xrefStart = pdf.length;
				pdf += `xref\n0 ${objects.length + 1}\n`;
				pdf += "0000000000 65535 f \n";

				for (let index = 1; index < offsets.length; index += 1) {
					pdf += `${String(offsets[index]).padStart(10, "0")} 00000 n \n`;
				}

				pdf += `trailer\n<< /Size ${objects.length + 1} /Root ${catalogId} 0 R >>\nstartxref\n${xrefStart}\n%%EOF`;

				return pdf;
			}

			function downloadPdf(data: DownloadCv) {
				const pdf = buildPdfDocument(data);
				const blob = new Blob([pdf], { type: "application/pdf" });
				const url = URL.createObjectURL(blob);
				const link = document.createElement("a");

				link.href = url;
				link.download = "min-aung-thu-win-cv.pdf";
				document.body.append(link);
				link.click();
				link.remove();

				window.setTimeout(() => {
					URL.revokeObjectURL(url);
				}, 1000);
			}

			downloadButton?.addEventListener("click", () => {
				if (!payload) return;

				try {
					downloadPdf(payload);
				} catch (error) {
					console.error("Failed to generate PDF, falling back to print.", error);
					window.print();
				}
			});
		</script>
	</body>
</html>

