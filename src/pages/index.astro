---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const siteUrl = new URL("/", Astro.site).toString();
const pageTitle = "Oung Seik Nyan | Backend Engineer Portfolio";
const pageDescription =
	"Backend engineer portfolio focused on automation platforms, distributed systems, real-time infrastructure, and developer tooling.";
const pageStructuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}#website`,
			url: siteUrl,
			name: "Oung Seik Nyan",
			description: pageDescription,
			inLanguage: "en",
		},
		{
			"@type": "Person",
			"@id": `${siteUrl}#person`,
			name: "Oung Seik Nyan",
			alternateName: "Min Aung Thu Win",
			url: siteUrl,
			jobTitle: "Backend & Systems Engineer",
			description: pageDescription,
			email: "mhemaungthuwin@gmail.com",
			sameAs: ["https://github.com/oungseik", "https://www.linkedin.com/in/aung-thu-win/"],
			knowsAbout: [
				"Backend engineering",
				"Automation platforms",
				"Distributed systems",
				"Real-time systems",
				"Developer infrastructure",
				"TypeScript",
			],
		},
		{
			"@type": "ProfilePage",
			"@id": `${siteUrl}#webpage`,
			url: siteUrl,
			name: pageTitle,
			description: pageDescription,
			isPartOf: { "@id": `${siteUrl}#website` },
			about: { "@id": `${siteUrl}#person` },
			mainEntity: { "@id": `${siteUrl}#person` },
			inLanguage: "en",
		},
	],
};

const selectedWork = [
	{
		eyebrow: "01 / Distributed Device Farm",
		title: "Test Canvas",
		summary:
			"A platform that automates mobile testing infrastructure by eliminating manual device setup.",
		points: [
			"Designed a distributed system to manage Android and iOS devices across multiple servers.",
			"Automated Appium and Selenium setup per device for plug-and-play testing.",
			"Implemented real-time monitoring, screen streaming, and access control.",
		],
		impact: [
			"Cut QA setup from ~30 minutes to near zero.",
			"Runs tests in parallel across 10+ devices.",
		],
		tech: ["TypeScript", "Express", "MongoDB", "Socket.IO", "Appium", "ADB", "go-ios"],
	},
	{
		eyebrow: "02 / Shipping Automation Platform",
		title: "Bookogsend",
		summary:
			'A shipping platform enabling e-commerce businesses to automate logistics across multiple providers. <a href="https://bookogsend.dk/" class="text-info underline underline-offset-4">Live at bookogsend.dk</a>.',
		points: [
			"Integrated shipping providers including GLS and TeamJK.",
			"Built a WooCommerce plugin for automatic order synchronization.",
			"Designed reconciliation, inventory, and payment workflows for merchants.",
		],
		impact: ["Automated the order-to-shipment workflow across GLS and TeamJK."],
		tech: ["Next.js", "tRPC", "Prisma", "PostgreSQL", "Firebase Auth"],
	},
	{
		eyebrow: "03 / AI Data Interface",
		title: "SQL Agent",
		summary: "A microservice that lets users query relational databases with natural language.",
		points: [
			"Built an LLM-powered query system using LangChain.",
			"Designed a FastAPI service for orchestration and query execution.",
			"Generated charts and structured outputs for analytical workflows.",
		],
		impact: ["Non-technical users query relational databases in plain language."],
		tech: ["Python", "FastAPI", "LangChain"],
	},
];

const focusAreas = [
	{
		title: "Distributed systems",
		description: "Service boundaries, orchestration, and operational reliability.",
	},
	{
		title: "Real-time backend systems",
		description: "WebSockets, device coordination, monitoring, and event-driven flows.",
	},
	{
		title: "Developer tooling",
		description: "Internal platforms that remove manual setup and improve delivery speed.",
	},
	{
		title: "Type-safe APIs",
		description: "Modern TypeScript systems with predictable contracts and maintainable code.",
	},
	{
		title: "AI-assisted backends",
		description: "Practical interfaces that connect LLM workflows to business data.",
	},
];

/* ponytail: Bookogsend links to its live product (bookogsend.dk, from cv.md) — replace with per-project link field if more projects gain URLs */

const experience = [
	{ role: "Full-stack Developer", company: "Crossworks, Kiosk", period: "Apr 2025 – Present" },
	{ role: "Senior Backend Engineer", company: "Brillar", period: "Sep 2023 – Apr 2025" },
	{ role: "Frontend Developer", company: "Qualy Myanmar", period: "Apr 2022 – Apr 2023" },
];

const contactLinks = [
	{
		label: "Email",
		value: "mhemaungthuwin@gmail.com",
		href: "mailto:mhemaungthuwin@gmail.com",
	},
	{
		label: "GitHub",
		value: "github.com/oungseik",
		href: "https://github.com/oungseik",
	},
	{
		label: "LinkedIn",
		value: "linkedin.com/in/aung-thu-win",
		href: "https://www.linkedin.com/in/aung-thu-win/",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} structuredData={pageStructuredData} />
	</head>
	<body class="bg-base-100 text-base-content">
		<Header />

		<main>
			<section class="border-base-300/60 relative overflow-hidden border-b">
				<div
					class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(184,95,56,0.09),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(109,135,153,0.10),transparent_26%)]"
				>
				</div>

				<div
					class="relative mx-auto grid min-h-screen max-w-6xl gap-12 px-4 pt-32 pb-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center"
				>
					<div class="max-w-3xl">
						<p class="text-info mb-3 font-mono text-xs tracking-[0.32em] uppercase">
							Oung Seik Nyan
						</p>
						<p class="text-base-content/60 mb-6 font-mono text-xs tracking-[0.32em] uppercase">
							Backend & Systems Engineer
						</p>
						<h1
							class="max-w-4xl text-4xl font-bold tracking-tight text-balance md:text-6xl lg:text-7xl"
						>
							Backend engineer building automation platforms and distributed systems.
						</h1>
						<p class="text-base-content/70 mt-6 max-w-2xl text-lg leading-8 md:text-xl">
							I’m Oung — Min Aung Thu Win — a backend engineer working remotely from Mawlamyaine,
							Myanmar. Four-plus years in the TypeScript ecosystem, mostly on the parts users
							never see: device farms, shipping automation, and real-time services that stay up.
						</p>

						<div class="mt-10 flex flex-col gap-4 sm:flex-row">
							<a href="#projects" class="btn btn-info btn-lg text-base-100 rounded-full px-8">
								View Projects
							</a>
							<a
								href="https://github.com/oungseik"
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-outline btn-lg rounded-full px-8"
							>
								GitHub
							</a>
							<a href="#contact" class="btn btn-ghost btn-lg rounded-full px-8"> Contact </a>
						</div>
					</div>

					<div class="space-y-5">
						<div
							class="border-base-300/70 bg-base-200/55 shadow-base-300/10 rounded-[2rem] border p-6 shadow-2xl backdrop-blur"
						>
							<p class="text-base-content/60 font-mono text-xs tracking-[0.28em] uppercase">Now</p>
							<h2 class="mt-2 text-2xl font-semibold">Full-stack Developer at Crossworks</h2>
							<p class="text-base-content/70 mt-3 text-sm leading-6">
								Remote from Mawlamyaine, Myanmar · since Apr 2025. Previously Senior Backend Engineer
								at Brillar.
							</p>

							<div class="border-base-300/70 bg-base-100/60 mt-6 rounded-2xl border p-4">
								<p class="text-base-content/60 font-mono text-xs tracking-[0.22em] uppercase">
									GitHub · Oungseik
								</p>
								<img
									src="https://ghchart.rshah.org/b85f38/Oungseik"
									alt="GitHub contribution chart for Oungseik"
									class="mt-3 w-full rounded-lg"
									width="663"
									height="104"
									loading="lazy"
								/>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="projects" class="py-20 md:py-28">
				<div class="mx-auto max-w-6xl px-4">
					<div class="max-w-3xl">
						<p class="text-info font-mono text-xs tracking-[0.28em] uppercase">Selected Work</p>
						<h2 class="mt-4 text-3xl font-semibold tracking-tight md:text-5xl">
							Selected backend engineering projects in automation, orchestration, and reliability.
						</h2>
						<p class="text-base-content/70 mt-4 text-lg leading-8">
							Three systems I designed, built, and kept running in production.
						</p>
					</div>

					<div class="mt-12 grid gap-6 lg:grid-cols-3">
						{
							selectedWork.map((project) => (
								<article class="border-base-300/70 bg-base-200/45 shadow-base-300/5 flex h-full flex-col rounded-[2rem] border p-6 shadow-lg">
									<p class="text-base-content/60 font-mono text-xs tracking-[0.26em] uppercase">
										{project.eyebrow}
									</p>
									<h3 class="mt-4 text-2xl font-semibold">{project.title}</h3>
									<p class="text-base-content/70 mt-3 leading-7" set:html={project.summary} />

									<ul class="text-base-content/70 mt-6 space-y-3 text-sm leading-6">
										{project.points.map((point) => (
											<li class="flex gap-3">
												<span class="text-info mt-2 h-1.5 w-1.5 flex-none rounded-full bg-current" />
												<span>{point}</span>
											</li>
										))}
									</ul>

									<div class="border-base-300/70 bg-base-100/60 mt-6 rounded-2xl border p-4">
										<p class="text-base-content/60 font-mono text-xs tracking-[0.22em] uppercase">
											Impact
										</p>
										<ul class="text-base-content/70 mt-3 space-y-2 text-sm leading-6">
											{project.impact.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</div>

									<div class="mt-6 flex flex-wrap gap-2">
										{project.tech.map((item) => (
											<span class="border-base-300/70 bg-base-100/60 text-base-content/70 rounded-full border px-3 py-1 text-xs">
												{item}
											</span>
										))}
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>


			<section id="focus" class="border-base-300/60 bg-base-200/35 border-y py-20 md:py-24">
				<div class="mx-auto max-w-6xl px-4">
					<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
						<div class="max-w-xl">
							<p class="text-info font-mono text-xs tracking-[0.28em] uppercase">
								Engineering Focus
							</p>
							<h2 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">
								What I work on.
							</h2>
						</div>

						<div class="grid gap-4 md:grid-cols-2">
							{
								focusAreas.map((area) => (
									<div class="border-base-300/70 bg-base-200/40 rounded-[1.5rem] border p-5">
										<h3 class="text-lg font-semibold">{area.title}</h3>
										<p class="text-base-content/70 mt-3 text-sm leading-6">{area.description}</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="experience" class="py-20 md:py-24">
				<div class="mx-auto max-w-6xl px-4">
					<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
						<div class="max-w-xl">
							<p class="text-info font-mono text-xs tracking-[0.28em] uppercase">Experience</p>
							<h2 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">
								Where I’ve worked.
							</h2>
						</div>

						<div class="border-base-300/70 bg-base-200/45 rounded-[2rem] border p-6">
							<div class="space-y-4">
								{
									experience.map((item) => (
										<div class="border-base-300/70 bg-base-100/60 flex flex-col gap-2 rounded-2xl border px-5 py-4 md:flex-row md:items-center md:justify-between">
											<div>
												<h3 class="text-lg font-semibold">{item.role}</h3>
												<p class="text-base-content/60 text-sm">{item.company}</p>
											</div>
											<p class="text-base-content/60 font-mono text-xs tracking-[0.18em] uppercase">
												{item.period}
											</p>
										</div>
									))
								}
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="border-base-300/60 bg-base-200/35 border-y py-20 md:py-24">
				<div class="mx-auto max-w-6xl px-4">
					<div class="border-base-300/70 bg-base-100/65 rounded-[2rem] border p-8 md:p-10">
						<div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
							<div class="max-w-2xl">
								<p class="font-mono text-xs tracking-[0.18em] uppercase text-[#55697a]">Elsewhere</p>
								<h2 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">
									Where the work lives.
								</h2>
								<p class="text-base-content/70 mt-4 leading-8">
									GitHub for the code, LinkedIn for the professional trail, the CV for everything in
									order.
								</p>
							</div>

							<div class="flex flex-col">
					<a
						href="https://github.com/oungseik"
						target="_blank"
						rel="noopener noreferrer"
						class="link-row flex items-center justify-between gap-4 border-base-300/50 -mx-2 rounded-lg border-b px-2 py-4 transition-colors hover:bg-base-200/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content"
					>
						<span>
							<span class="text-base-content/70 block text-sm">GitHub</span>
							<span class="mt-1 block font-medium">github.com/oungseik</span>
						</span>
						<span class="link-arrow text-info text-xl">↗</span>
					</a>
					<a
						href="https://www.linkedin.com/in/aung-thu-win/"
						target="_blank"
						rel="noopener noreferrer"
						class="link-row flex items-center justify-between gap-4 border-base-300/50 -mx-2 rounded-lg border-b px-2 py-4 transition-colors hover:bg-base-200/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content"
					>
						<span>
							<span class="text-base-content/70 block text-sm">LinkedIn</span>
							<span class="mt-1 block font-medium">linkedin.com/in/aung-thu-win</span>
						</span>
						<span class="link-arrow text-info text-xl">↗</span>
					</a>
					<a
						href="/cv"
						class="link-row flex items-center justify-between gap-4 border-base-300/50 -mx-2 rounded-lg border-b px-2 py-4 transition-colors hover:bg-base-200/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content"
					>
						<span>
							<span class="text-base-content/70 block text-sm">Resume</span>
							<span class="mt-1 block font-medium">Full CV — history, education, skills</span>
						</span>
						<span class="link-arrow text-info text-xl">↗</span>
					</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section id="contact" class="py-20 md:py-24">
				<div class="mx-auto max-w-6xl px-4">
					<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
						<div class="max-w-xl">
							<p class="text-info font-mono text-xs tracking-[0.28em] uppercase">Contact</p>
							<h2 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">
								Let’s talk about backend systems, automation, or platform engineering roles.
							</h2>
							<p class="text-base-content/70 mt-4 leading-8">
								Email is best. GitHub, LinkedIn, and the CV have the rest.
							</p>
						</div>

						<div class="grid gap-4">
							{
								contactLinks.map((link) => (
									<a
										href={link.href}
										target={link.href.startsWith("http") ? "_blank" : undefined}
										rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
										class="border-base-300/70 bg-base-200/40 hover:bg-base-200/70 flex items-center justify-between rounded-[1.5rem] border px-5 py-5 transition-colors"
									>
										<span>
											<span class="text-base-content/70 block text-sm">{link.label}</span>
											<span class="mt-1 block text-lg font-medium">{link.value}</span>
										</span>
										<span class="text-info text-xl">↗</span>
									</a>
								))
							}
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
