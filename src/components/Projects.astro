---
const projects = [
	{
		title: "Test Canvas",
		description:
			"Private Device Cloud platform enabling effortless testing and optimization on actual Android and iOS devices for impeccable app quality and performance.",
		image: "testcanvas/devices.png",
		link: "/projects/test-canvas",
		tags: ["Full-Stack", "Cloud", "Testing"],
	},
	{
		title: "Nix Config",
		description:
			"My ever growing Desktop & Neovim configuration in Nix, which can easily adopt, and extend by everyone.",
		image: "workspace/nixos.png",
		link: "/projects/nix-config",
		tags: ["DevOps", "Linux", "Configuration"],
	},
];
---

<section class="bg-base-100 py-16 md:py-24" id="projects">
	<div class="mx-auto max-w-5xl px-4">
		<h2 class="section-title">Featured Projects</h2>
		<p class="section-subtitle">
			A selection of projects I've worked on that showcase my skills and expertise.
		</p>

		<div class="mt-12 space-y-8">
			{
				projects.map((project, idx) => (
					<div
						class="bg-base-200/50 card-hover opacity-0-initial animate-fade-in-up overflow-hidden rounded-2xl"
						class:list={[`animation-delay-${(idx + 1) * 100}`]}
					>
						<div
							class:list={[
								"grid grid-cols-1",
								idx % 2 === 1 ? "md:grid-cols-[1fr_1.2fr]" : "md:grid-cols-[1.2fr_1fr]",
							]}
						>
							<div class:list={[idx % 2 === 1 ? "md:order-last" : ""]}>
								<figure class="aspect-video md:aspect-auto md:h-full">
									<img class="h-full w-full object-cover" src={project.image} alt={project.title} />
								</figure>
							</div>
							<div class="flex flex-col justify-center p-6 md:p-8">
								<h3 class="text-info mb-3 text-xl font-bold md:text-2xl">{project.title}</h3>
								<p class="text-base-content/70 mb-4 leading-relaxed">{project.description}</p>
								<div class="mb-6 flex flex-wrap gap-2">
									{project.tags.map((tag) => (
										<span class="badge badge-primary/20 badge-outline text-xs">{tag}</span>
									))}
								</div>
								<a href={project.link} class="btn btn-outline btn-primary btn-sm w-fit gap-2">
									View Project
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="18"
										height="18"
										viewBox="0 0 24 24"
									>
										<path
											fill="none"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="m10 7l5 5l-5 5"
										/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
